class "IfcPropertySetAPI" (
    doc = """One IFC property set (IfcPropertySet or predefined property set).

    Multiple-apply: the instance name is the sanitized set name and every
    property is written as ifc:pset:<instance>:<property>, with displayGroup
    holding the original set name and displayName the original property
    name. Set-level data is kept in prim customData under ifc:propertySets."""
)
{
}

class "IfcQuantitySetAPI" (
    doc = """One IFC quantity set (IfcElementQuantity).

    Multiple-apply: quantities are written as ifc:qto:<instance>:<quantity>
    in project units, with the unit in customData.ifcUnit."""
)
{
}
